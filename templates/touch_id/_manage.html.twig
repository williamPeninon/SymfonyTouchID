{# @TouchId/touch_id/_manage.html.twig #}
{#
  Usage (pass credentials from TouchIdManager::listCredentials):
  {% include '@TouchId/touch_id/_manage.html.twig' with { credentials: webAuthnCredentials } %}
#}
<div
    class="{{ wrapper_class|default('') }}"
    data-controller="webauthn-register"
    data-webauthn-register-options-url-value="{{ path('webauthn_register_options') }}"
    data-webauthn-register-verify-url-value="{{ path('webauthn_register_verify') }}"
    data-webauthn-register-delete-url-template-value="{{ path('webauthn_credential_delete', { id: 999999999 })|replace({'999999999': '__ID__'}) }}"
    data-cancel-message="{{ (cancel_message|default('account.webauthn.cancelled'))|trans }}"
    data-error-message="{{ (error_message|default('account.webauthn.register_failed'))|trans }}"
    data-success-message="{{ (success_message|default('account.webauthn.registered'))|trans }}"
    data-deleted-message="{{ (deleted_message|default('account.webauthn.deleted'))|trans }}"
    data-confirm-delete="{{ (confirm_delete|default('account.webauthn.confirm_delete'))|trans }}"
    data-delete-label="{{ (delete_label|default('account.webauthn.delete'))|trans }}"
    data-host-message="{{ (host_message|default('account.webauthn.invalid_host'))|trans }}"
>
    <div class="alert alert-info" data-webauthn-register-target="unsupported" hidden>
        {{ (mac_only|default('account.webauthn.mac_only'))|trans }}
    </div>

    <div data-webauthn-register-target="panel" hidden>
        <div class="alert alert-danger" data-webauthn-register-target="error" hidden></div>
        <div class="alert alert-success" data-webauthn-register-target="success" hidden></div>

        <p class="text-muted mb-3" data-webauthn-register-target="empty" {% if credentials is not empty %}hidden{% endif %}>
            {{ (empty_message|default('account.webauthn.empty'))|trans }}
        </p>

        <ul class="list-unstyled mb-3" data-webauthn-register-target="list" {% if credentials is empty %}hidden{% endif %}>
            {% for credential in credentials %}
                <li class="webauthn-credential d-flex justify-content-between align-items-center py-2 border-bottom" data-webauthn-credential-id="{{ credential.id }}">
                    <div>
                        <strong>{{ credential.name }}</strong>
                        <div class="small text-muted">{{ credential.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-danger"
                        data-action="webauthn-register#remove"
                        data-credential-id="{{ credential.id }}"
                    >
                        {{ (delete_label|default('account.webauthn.delete'))|trans }}
                    </button>
                </li>
            {% endfor %}
        </ul>

        <button
            type="button"
            class="{{ add_button_class|default('btn btn-primary') }}"
            data-webauthn-register-target="button"
            data-action="webauthn-register#register"
        >
            {{ (add_label|default('account.webauthn.add'))|trans }}
        </button>
    </div>
</div>
