{
    "name": "wpconsulting/touch-id-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for WebAuthn platform passkeys (Face ID, Touch ID, Samsung fingerprint, Windows Hello).",
    "keywords": [
        "symfony",
        "webauthn",
        "passkey",
        "touch-id",
        "biometric",
        "authentication",
        "symfony-ux",
        "flex"
    ],
    "homepage": "https://github.com/williamPeninon/SymfonyTouchID",
    "license": "MIT",
    "authors": [
        {
            "name": "WP Consulting",
            "homepage": "https://wpconsulting.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/williamPeninon/SymfonyTouchID/issues",
        "source": "https://github.com/williamPeninon/SymfonyTouchID"
    },
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "doctrine/orm": "^2.17|^3.0",
        "lbuchs/webauthn": "^2.2",
        "symfony/console": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/security-bundle": "^6.4|^7.0",
        "symfony/stimulus-bundle": "^2.9",
        "symfony/translation-contracts": "^3.0",
        "symfony/twig-bundle": "^6.4|^7.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5",
        "symfony/yaml": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "WpConsulting\\TouchIdBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpConsulting\\TouchIdBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        },
        "symfony": {
            "allow-contrib": true
        }
    },
    "minimum-stability": "stable"
}
