{
    "manifests": {
        "wpconsulting/passkey-bundle": {
            "manifest": {
                "bundles": {
                    "WpConsulting\\PasskeyBundle\\PasskeyBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "aliases": [
                    "passkey",
                    "webauthn-passkey"
                ]
            },
            "files": {
                "config/packages/wp_consulting_passkey.yaml": {
                    "contents": [
                        "# config/packages/wp_consulting_passkey.yaml",
                        "wp_consulting_passkey:",
                        "    # Set by passkey:configure, or manually to your User FQCN:",
                        "    user_class: ~",
                        "    # user_class: App\\Entity\\User",
                        "    user_identifier_field: email",
                        "    rp_name: 'My App'",
                        "    login_authenticator: form_login",
                        "    default_redirect_route: app_account",
                        "    translation_domain: PasskeyBundle",
                        "    translation_prefix: ''",
                        "    email_input_selector: '#username, input[name=\"_username\"], input[name=\"email\"], input[type=\"email\"]'",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/passkey.yaml": {
                    "contents": [
                        "passkey:",
                        "    resource: '@PasskeyBundle/config/routes.yaml'",
                        ""
                    ],
                    "executable": false
                },
                "config/packages/dev/framework.yaml": {
                    "contents": [
                        "# Trusted proxies for local HTTPS tunnels (ngrok, etc.)",
                        "# Loaded only when APP_ENV=dev — not applied in prod.",
                        "framework:",
                        "    # passkey-trusted-proxies",
                        "    trusted_proxies: '127.0.0.1,REMOTE_ADDR'",
                        "    trusted_headers: ['x-forwarded-for', 'x-forwarded-host', 'x-forwarded-proto', 'x-forwarded-port']",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "flex-1.0.1"
        }
    }
}
