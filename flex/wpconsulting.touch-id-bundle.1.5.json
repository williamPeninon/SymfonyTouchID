{
    "manifests": {
        "wpconsulting/touch-id-bundle": {
            "manifest": {
                "bundles": {
                    "WpConsulting\\TouchIdBundle\\TouchIdBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "aliases": [
                    "touch-id",
                    "webauthn-touch-id"
                ],
                "post-install-output": [
                    "",
                    "<bg=blue;fg=white> wpconsulting/touch-id-bundle </>",
                    "",
                    "  * Confirm <comment>user_class</comment> when prompted (or edit wp_consulting_touch_id.yaml).",
                    "  * Implement <comment>TouchIdUserInterface</> on your User entity.",
                    "  * Add PUBLIC_ACCESS for <comment>^/webauthn/login</> in security.yaml.",
                    "  * Enable Stimulus controllers in <comment>assets/controllers.json</> (see README).",
                    "  * Create the table: <comment>php bin/console doctrine:migrations:diff && doctrine:migrations:migrate</>",
                    "  * Twig: <comment>touch_id_credentials(app.user)</> / global <comment>touch_id_manager</>.",
                    ""
                ]
            },
            "files": {
                "config/packages/wp_consulting_touch_id.yaml": {
                    "contents": [
                        "# config/packages/wp_consulting_touch_id.yaml",
                        "wp_consulting_touch_id:",
                        "    # Filled by the Composer plugin prompt when interactive;",
                        "    # otherwise set to your User FQCN (e.g. App\\Entity\\User).",
                        "    user_class: ~",
                        "    # user_class: App\\Entity\\User",
                        "    # Doctrine field used to look up the user at login (email / username / …)",
                        "    user_identifier_field: email",
                        "    rp_name: 'My App'",
                        "    login_authenticator: form_login",
                        "    default_redirect_route: app_account",
                        "    # Optional: App\\Security\\LoginSuccessHandler",
                        "    # success_handler: null",
                        "    translation_domain: TouchIdBundle",
                        "    translation_prefix: ''",
                        "    # CSS selectors to read the email on the login form (comma-separated)",
                        "    email_input_selector: '#username, input[name=\"_username\"], input[name=\"email\"], input[type=\"email\"]'",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/touch_id.yaml": {
                    "contents": [
                        "touch_id:",
                        "    resource: '@TouchIdBundle/config/routes.yaml'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "flex-1.5.5"
        }
    }
}
