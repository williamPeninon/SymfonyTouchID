{
    "manifests": {
        "wpconsulting/touch-id-bundle": {
            "manifest": {
                "bundles": {
                    "WpConsulting\\TouchIdBundle\\TouchIdBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "aliases": [
                    "touch-id",
                    "webauthn-touch-id"
                ],
                "post-install-output": [
                    "",
                    "<bg=blue;fg=white> wpconsulting/touch-id-bundle </>",
                    "",
                    "  * Run <comment>php bin/console touch-id:configure</> (user_class, User interface, Stimulus, DB).",
                    "  * Twig: include <comment>@TouchId/touch_id/_login_button.html.twig</> + <comment>_manage.html.twig</>.",
                    ""
                ]
            },
            "files": {
                "config/packages/wp_consulting_touch_id.yaml": {
                    "contents": [
                        "# config/packages/wp_consulting_touch_id.yaml",
                        "wp_consulting_touch_id:",
                        "    # Set by touch-id:configure, or manually to your User FQCN:",
                        "    user_class: ~",
                        "    # user_class: App\\Entity\\User",
                        "    # Doctrine field used to look up the user at login (email / username / …)",
                        "    user_identifier_field: email",
                        "    rp_name: 'My App'",
                        "    login_authenticator: form_login",
                        "    default_redirect_route: app_account",
                        "    # Optional: App\\Security\\LoginSuccessHandler",
                        "    # success_handler: null",
                        "    translation_domain: TouchIdBundle",
                        "    translation_prefix: ''",
                        "    # CSS selectors to read the email on the login form (comma-separated)",
                        "    email_input_selector: '#username, input[name=\"_username\"], input[name=\"email\"], input[type=\"email\"]'",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/touch_id.yaml": {
                    "contents": [
                        "touch_id:",
                        "    resource: '@TouchIdBundle/config/routes.yaml'",
                        ""
                    ],
                    "executable": false
                },
                "config/packages/dev/framework.yaml": {
                    "contents": [
                        "# Trusted proxies for local HTTPS tunnels (ngrok, etc.)",
                        "# Loaded only when APP_ENV=dev — not applied in prod.",
                        "framework:",
                        "    # touch-id-trusted-proxies",
                        "    # Trust X-Forwarded-* so CSRF Origin / WebAuthn RP ID match the public https host",
                        "    trusted_proxies: '127.0.0.1,REMOTE_ADDR'",
                        "    trusted_headers: ['x-forwarded-for', 'x-forwarded-host', 'x-forwarded-proto', 'x-forwarded-port']",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "flex-2.0.0"
        }
    }
}
