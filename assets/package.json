{
  "name": "@wpconsulting/passkey-bundle",
  "version": "3.0.6",
  "description": "WebAuthn / passkey Stimulus controllers (Touch ID, Face ID, Samsung fingerprint, Windows Hello)",
  "type": "module",
  "symfony": {
    "controllers": {
      "login": {
        "main": "controllers/login_controller.js",
        "name": "passkey-login",
        "fetch": "lazy",
        "enabled": true,
        "autoimport": {
          "@wpconsulting/passkey-bundle/styles/passkey.css": true
        }
      },
      "register": {
        "main": "controllers/register_controller.js",
        "name": "passkey-register",
        "fetch": "lazy",
        "enabled": true,
        "autoimport": {
          "@wpconsulting/passkey-bundle/styles/passkey.css": true
        }
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0"
  }
}
